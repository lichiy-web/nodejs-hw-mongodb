{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Phonebook App",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "Phonebook app allowes to store user's contacts in the database, edit them, and access to them from anywhere on Earth having internet connection."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://example.com/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Operations with contacts."
    },
    {
      "name": "Auth",
      "description": "Auth operations."
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get a list of the user's contacts",
        "operationId": "getAllContacts",
        "description": "Get **an array** of objects representing **the contacts** created by the user. </br> Use **filters** as query parameters to narrow down the server response. </br> **Sort** response by the specific parameter in ascending or descending order. </br> Use **pagination** by passing the page number and number of contacts per page in the query parameters.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "in": "query",
            "name": "perPage",
            "schema": {
              "type": "integer",
              "example": 10
            }
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": {
              "type": "string",
              "example": "name"
            },
            "description": "All contacts's fields can be mentioned. Default value - _id"
          },
          {
            "in": "query",
            "name": "sortOrder",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "example": "asc"
            }
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string",
              "enum": [
                "work",
                "home",
                "personal"
              ],
              "example": "home"
            }
          },
          {
            "in": "query",
            "name": "isFavourite",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/getAllContacts-200"
          },
          "400": {
            "$ref": "#/components/responses/getAllContacts-400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create a new contact",
        "operationId": "createContact",
        "description": "**Create** a new contact.Request contains **a body** as a **json** object with contact update data or **multipart/formdata** body that can contain avatar image.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "description": "Provide data of the new contact .",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "phoneNumber",
                  "contactType"
                ],
                "properties": {
                  "name": {
                    "description": "The contact's name",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "John Snow"
                  },
                  "phoneNumber": {
                    "description": "The phone number of the contact",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "+380501234567"
                  },
                  "email": {
                    "description": "Must be a valid email",
                    "type": "string",
                    "example": "john.snow@winterfell.com"
                  },
                  "isFavourite": {
                    "description": "Is the contact a favourite?",
                    "type": "boolean",
                    "example": false
                  },
                  "contactType": {
                    "description": "Contact group by area of their use",
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "personal"
                    ],
                    "example": "personal"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "phoneNumber",
                  "contactType"
                ],
                "properties": {
                  "photo": {
                    "description": "The file of the contact's avatar image uploaded to the cloud or server",
                    "type": "string",
                    "format": "binary"
                  },
                  "name": {
                    "description": "The contact's name",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "John Snow"
                  },
                  "phoneNumber": {
                    "description": "The phone number of the contact",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "+380501234567"
                  },
                  "email": {
                    "description": "Must be a valid email",
                    "type": "string",
                    "example": "john.snow@winterfell.com"
                  },
                  "isFavourite": {
                    "description": "Is the contact a favourite?",
                    "type": "boolean",
                    "example": false
                  },
                  "contactType": {
                    "description": "Contact group by area of their use",
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "personal"
                    ],
                    "example": "personal"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/createContact-201"
          },
          "400": {
            "$ref": "#/components/responses/createContact-400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get a contact by its id",
        "operationId": "getContactById",
        "description": "**Get** an object representing the **contact** by its **id** passed as an url parameter [/contacts/:contactId](/contacts/:contactId). </br> Parameter **contactId** must be a valid id: 24 hexadecimal symbols.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": {
              "type": "string",
              "example": "67f6381e907fe15ef69f1df0"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/getContactById-200"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/getContactById-404"
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts"
        ],
        "summary": "Delete the user's contact by its id",
        "operationId": "deleteContact",
        "description": "**Delete** an object representing the **contact** by its **id** passed as an url parameter [/contacts/:contactId](/contacts/:contactId). </br> Parameter **contactId** must be a valid id: 24 hexadecimal symbols.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": {
              "type": "string",
              "example": "67f6381e907fe15ef69f1df0"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The contact has deleted successfully."
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/getContactById-404"
          }
        }
      },
      "put": {
        "tags": [
          "Contacts"
        ],
        "summary": "Upsert a contact.",
        "operationId": "upsertContact",
        "description": "**Update** existing contact or **create** the new one if it's absent in the database. Request contains **a body** as a **json** object with contact update data or **multipart/formdata** body that can contain avatar image",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": {
              "type": "string",
              "example": "67f6381e907fe15ef69f1df0"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "phoneNumber",
                  "contactType"
                ],
                "properties": {
                  "name": {
                    "description": "The contact's name",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "John Snow"
                  },
                  "phoneNumber": {
                    "description": "The phone number of the contact",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "+380501234567"
                  },
                  "email": {
                    "description": "Must be a valid email",
                    "type": "string",
                    "example": "john.snow@winterfell.com"
                  },
                  "isFavourite": {
                    "description": "Is the contact a favourite?",
                    "type": "boolean",
                    "example": false
                  },
                  "contactType": {
                    "description": "Contact group by area of their use",
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "personal"
                    ],
                    "example": "personal"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/putContact-200"
          },
          "201": {
            "$ref": "#/components/responses/createContact-201"
          },
          "400": {
            "$ref": "#/components/responses/createContact-400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "patch": {
        "tags": [
          "Contacts"
        ],
        "summary": "Patch existing contact",
        "operationId": "patchContact",
        "description": "**Patch** existing contact by its id. Request contains **a body** as a **json** object with contact update data or **multipart/formdata** body that can contain avatar image",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": {
              "type": "string",
              "example": "67f6381e907fe15ef69f1df0"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "description": "The contact's name",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "John Snow"
                  },
                  "phoneNumber": {
                    "description": "The phone number of the contact",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "+380501234567"
                  },
                  "email": {
                    "description": "Must be a valid email",
                    "type": "string",
                    "example": "john.snow@winterfell.com"
                  },
                  "isFavourite": {
                    "description": "Is the contact a favourite?",
                    "type": "boolean",
                    "example": false
                  },
                  "contactType": {
                    "description": "Contact group by area of their use",
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "personal"
                    ],
                    "example": "personal"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/patchContact-200"
          },
          "400": {
            "$ref": "#/components/responses/createContact-400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/getContactById-404"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearerss"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "_id",
          "userId",
          "name",
          "phoneNumber",
          "contactType"
        ],
        "properties": {
          "_id": {
            "description": "Contact's id",
            "type": "string",
            "example": "67f6381e907fe15ef69f1df0"
          },
          "userId": {
            "description": "The id of the user who created this contact",
            "type": "string",
            "example": "67f6364eeba7c0aedb007d73"
          },
          "photo": {
            "description": "URL of the contact's avatar image uploaded to the cloud or server",
            "type": "string",
            "example": "https://res.cloudinary.com/dbkdexyl9/image/upload/v1745741839/swbjzex5zv6lsncc4d3e.jpg"
          },
          "name": {
            "description": "The contact's name",
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "example": "John Snow"
          },
          "phoneNumber": {
            "description": "The phone number of the contact",
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "example": "+380501234567"
          },
          "email": {
            "description": "Must be a valid email",
            "type": "string",
            "example": "john.snow@winterfell.com"
          },
          "isFavourite": {
            "description": "Is the contact a favourite?",
            "type": "boolean",
            "example": false
          },
          "contactType": {
            "description": "Contact group by area of their use",
            "type": "string",
            "enum": [
              "work",
              "home",
              "personal"
            ],
            "example": "personal"
          }
        }
      },
